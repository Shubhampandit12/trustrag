# Copy to .env and fill in. Never commit .env.
HF_TOKEN=                       # HuggingFace token (only needed for gated models like Llama-3)
WANDB_API_KEY=                  # optional; offline logging works without it
# Generation backend: vLLM OpenAI-compatible server (train + serve use the SAME one).
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
LLM_API_KEY=EMPTY               # vLLM ignores this; set a real key for a hosted endpoint
# External LLM judge (must be DISTINCT from the generator to avoid self-preference bias).
JUDGE_BASE_URL=                 # e.g. https://api.openai.com/v1 or an Anthropic-compat gateway
JUDGE_MODEL=                    # pinned version string, e.g. gpt-4o-2024-08-06
JUDGE_API_KEY=
